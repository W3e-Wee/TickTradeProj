# Default text normalization; explicit LF rules keep build/source inputs stable.
* text=auto
*.c text eol=lf
*.h text eol=lf
*.S text eol=lf
*.s text eol=lf
*.py text eol=lf
*.sh text eol=lf
*.ps1 text eol=crlf
Makefile text eol=lf
*.mk text eol=lf
*.md text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.json text eol=lf
*.txt text eol=lf
*.csv text eol=lf

# Preserve binary formats byte-for-byte.
*.pdf binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.svg text eol=lf
*.zip binary
*.gz binary
