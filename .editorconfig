root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{c,h,S,s}]
indent_style = space
indent_size = 4

[*.py]
indent_style = space
indent_size = 4

[Makefile]
indent_style = tab

[*.{md,sh,ps1,yaml,yml,mk,json}]
indent_style = space
indent_size = 2

[*.ps1]
end_of_line = crlf

[*.md]
trim_trailing_whitespace = false
